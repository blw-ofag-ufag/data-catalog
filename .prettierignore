# Build and deploy artifacts.
# docs/ is NOT throwaway output: per README, an on-prem deployment points its web server
# document root at /docs. It is regenerated by .github/workflows/develop.yaml and committed
# back to develop, so anything we reformat here is overwritten on the next deploy anyway.
docs/
dist/
coverage/
.angular/

# Generated at build time by `npm run prebuild` (config/convert-yaml.js, convert-schemas.js,
# convert-form-layout.js). Formatting these would be undone by the next prebuild, leaving the
# working tree permanently dirty.
src/app/codegen/

# Managed by npm.
node_modules/
package-lock.json

# The workflow files use a deliberate 4-space, aligned-hyphen YAML style ("-   name:") that
# prettier would flatten to 2-space "- name:", rewriting every line of both files for no
# functional gain. They are few and hand-maintained; keep the existing convention.
.github/
