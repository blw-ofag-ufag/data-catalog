{
  "name": "Agri-Food Data Catalog",
  "version": "2.1.6",
  "scripts": {
    "start": "ng serve",
    "start:e2e": "ng serve --configuration e2e --port 4300",
    "prebuild": "node config/convert-yaml.js && node config/convert-schemas.js && node config/convert-form-layout.js",
    "build": "ng build --base-href /data-catalog/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --ci",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:local": "playwright test --config=playwright.local.config.ts",
    "lint": "ng lint",
    "format": "",
    "format-old": "npm run lint -- --fix",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/material-date-fns-adapter": "^21.2.14",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@oblique/oblique": "^15.4.0",
    "@popperjs/core": "^2.0.0",
    "angular-oauth2-oidc": "^20.0.0",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.1.0",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "marked": "^18.0.0",
    "ngx-translate-multi-http-loader": "^20.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^21.0.0",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@playwright/test": "^1.50.0",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "angular-eslint": "^21.0.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "jasmine-core": "~5.6.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "js-yaml": "^4.2.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.62.1",
    "yaml": "^2.8.0"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1",
    "launch-editor": "^2.14.1",
    "vite": "^7.3.5",
    "webpack-dev-server": {
      ".": "^5.2.5",
      "http-proxy-middleware": "^2.0.10"
    },
    "@angular-devkit/build-angular": {
      "http-proxy-middleware": "^3.0.7"
    },
    "@angular/build": {
      "undici": "^7.28.0",
      "piscina": "^5.2.0"
    }
  }
