# Normalize all text files to LF in the repository and on checkout.
# Overrides any local core.autocrlf setting so line endings stay consistent.
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
